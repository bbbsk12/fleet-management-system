<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_management_system</name>
  <version>1.0.0</version>
  <description>Multi-robot fleet management system based on ROS2 and Zenoh</description>
  <maintainer email="admin@fleet.com">Fleet Admin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fleet_manager</exec_depend>
  <exec_depend>fleet_monitor</exec_depend>
  <exec_depend>traffic_editor</exec_depend>
  <exec_depend>fleet_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>